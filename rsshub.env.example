PORT=1200
LISTEN_INADDR_ANY=0
CACHE_TYPE=memory

# X 网页登录 Cookie 中 auth_token 的值
# TWITTER_AUTH_TOKEN=

# 微博登录 Cookie，公开账号也可以使用访客模式
# WEIBO_COOKIES=

# 微博访客模式可以使用本机 Chrome
# CHROMIUM_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# 需要代理时填入本机实际地址
# PROXY_URI=http://127.0.0.1:7890
# PROXY_STRATEGY=all
